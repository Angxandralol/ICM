# Copy this file to .env.docker and fill in real values before running `make setup`.
# .env.docker is only used by docker-compose (backend/frontend/postgres orchestration).
# It does NOT replace .env / .env.production used for non-docker runs.

# PostgreSQL (used to create the "postgres" service and to build URI_POSTGRES for the backend)
POSTGRES_USER=icm_user
POSTGRES_PASSWORD=changeme
POSTGRES_DB=icm_db

# Backend (icm.utils.Configuration)
SECRET_KEY=changeme
# Public origin from which the browser will access the system (through nginx, no port needed for 80)
HOST_FRONTEND=http://localhost

# Frontend (baked into the Next.js build)
NEXT_PUBLIC_API_URL=http://localhost/api

# Port exposed on the host by nginx (reverse proxy for frontend + backend)
HTTP_PORT=80
